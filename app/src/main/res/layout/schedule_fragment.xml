<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_title" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_subtitle" android:layout_marginTop="4dp" android:textSize="14sp" />
        <TextView android:id="@+id/schedule_identity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textStyle="bold" />
        <TextView android:id="@+id/schedule_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton android:id="@+id/schedule_create" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/schedule_new" android:layout_marginTop="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.TextButton" android:id="@+id/schedule_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/schedule_refresh" />
            <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.TextButton" android:id="@+id/schedule_notification_settings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/schedule_notifications" />
        </LinearLayout>
        <EditText android:id="@+id/schedule_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="text" android:singleLine="true" android:hint="@string/schedule_search" android:autofillHints="" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Spinner android:id="@+id/schedule_mode" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:contentDescription="@string/schedule_mode" />
            <Spinner android:id="@+id/schedule_status_filter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:contentDescription="@string/schedule_filter_status" />
        </LinearLayout>
        <LinearLayout android:id="@+id/schedule_date_navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <Button android:id="@+id/schedule_previous" android:layout_width="48dp" android:layout_height="48dp" android:text="‹" android:contentDescription="@string/schedule_previous" />
            <Button android:id="@+id/schedule_selected_date" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:contentDescription="@string/schedule_date" />
            <Button android:id="@+id/schedule_next" android:layout_width="48dp" android:layout_height="48dp" android:text="›" android:contentDescription="@string/schedule_next" />
        </LinearLayout>
        <Button android:id="@+id/schedule_today" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/schedule_today" />
        <GridLayout android:id="@+id/schedule_calendar_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="7" />
        <TextView android:id="@+id/schedule_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/schedule_loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
        <TextView android:id="@+id/schedule_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" />
        <LinearLayout android:id="@+id/schedule_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
