<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_subject" android:labelFor="@id/schedule_editor_subject" />
        <Spinner android:id="@+id/schedule_editor_subject" android:layout_width="match_parent" android:layout_height="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_date" android:labelFor="@id/schedule_editor_date" />
        <Button android:id="@+id/schedule_editor_date" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_start" android:labelFor="@id/schedule_editor_start" />
        <Button android:id="@+id/schedule_editor_start" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_end" android:labelFor="@id/schedule_editor_end" />
        <Button android:id="@+id/schedule_editor_end" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <EditText android:id="@+id/schedule_editor_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/schedule_location" android:inputType="textCapSentences" android:maxLength="200" android:autofillHints="" />
        <TextView android:id="@+id/schedule_editor_status_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_status" android:labelFor="@id/schedule_editor_status" />
        <Spinner android:id="@+id/schedule_editor_status" android:layout_width="match_parent" android:layout_height="48dp" />
        <TextView android:id="@+id/schedule_editor_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="assertive" />
    </LinearLayout>
</ScrollView>
